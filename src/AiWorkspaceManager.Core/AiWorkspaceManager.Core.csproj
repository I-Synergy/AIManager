<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Sidecar entry point. Composition only: Program.cs wires handler groups and runs the server.
    Nullability, analyzers, warnings-as-errors and RollForward come from the root
    Directory.Build.props — do not repeat them here.
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <RootNamespace>AiWorkspaceManager.Core</RootNamespace>
    <!-- Published framework-dependent and launched as `dotnet AiWorkspaceManager.Core.dll`:
         one build for every OS/arch, no per-OS apphost binary in the VSIX. -->
    <UseAppHost>false</UseAppHost>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\AiWorkspaceManager.Common\AiWorkspaceManager.Common.csproj" />
    <ProjectReference Include="..\AiWorkspaceManager.Core.Catalog\AiWorkspaceManager.Core.Catalog.csproj" />
    <ProjectReference Include="..\AiWorkspaceManager.Core.Workspace\AiWorkspaceManager.Core.Workspace.csproj" />
  </ItemGroup>

</Project>
