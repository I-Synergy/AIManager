{
  "name": "aiworkspacemanager",
  "displayName": "AI Workspace Manager for Visual Studio Code",
  "description": "Browse, install, update and prune the skills and agents each repository installs — a full-page front-end for a bundled .NET resolver",
  "version": "0.13.3",
  "publisher": "I-Synergy",
  "license": "MIT",
  "icon": "images/icon.png",
  "galleryBanner": {
    "color": "#6366f1",
    "theme": "dark"
  },
  "homepage": "https://github.com/I-Synergy/AIWorkspaceManager#readme",
  "bugs": {
    "url": "https://github.com/I-Synergy/AIWorkspaceManager/issues"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/I-Synergy/AIWorkspaceManager.git"
  },
  "engines": {
    "vscode": "^1.110.0"
  },
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": false
    }
  },
  "categories": [
    "AI",
    "Machine Learning",
    "Other"
  ],
  "keywords": [
    "copilot",
    "skills",
    "agents",
    "template",
    "catalog",
    "ai"
  ],
  "main": "./dist/extension.js",
  "activationEvents": [
    "onView:aiManager.launcher",
    "workspaceContains:.ai/ai.json",
    "onWebviewPanel:aiManager.panel"
  ],
  "contributes": {
    "commands": [
      {
        "command": "aiManager.open",
        "title": "AI Workspace Manager: Open",
        "icon": "$(library)"
      },
      {
        "command": "aiManager.setup",
        "title": "AI Workspace Manager: Select Skills and Agents",
        "icon": "$(checklist)"
      },
      {
        "command": "aiManager.updates",
        "title": "AI Workspace Manager: Check for Updates",
        "icon": "$(cloud-download)"
      },
      {
        "command": "aiManager.sync",
        "title": "AI Workspace Manager: Sync Selection",
        "icon": "$(sync)"
      },
      {
        "command": "aiManager.openManifest",
        "title": "AI Workspace Manager: Open .ai/ai.json",
        "icon": "$(json)"
      },
      {
        "command": "aiManager.refresh",
        "title": "AI Workspace Manager: Refresh",
        "icon": "$(refresh)"
      },
      {
        "command": "aiManager.installItem",
        "title": "AI Workspace Manager: Install This Item",
        "icon": "$(add)"
      },
      {
        "command": "aiManager.removeItem",
        "title": "AI Workspace Manager: Remove This Item",
        "icon": "$(trash)"
      },
      {
        "command": "aiManager.vendorTooling",
        "title": "AI Workspace Manager: Vendor the Vocabulary Into This Repo",
        "icon": "$(cloud-download)"
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "aiManager",
          "title": "AI Workspace Manager",
          "icon": "images/activity-icon.svg"
        }
      ]
    },
    "views": {
      "aiManager": [
        {
          "id": "aiManager.launcher",
          "name": "AI Workspace Manager"
        }
      ]
    },
    "menus": {
      "view/title": [
        {
          "command": "aiManager.open",
          "when": "view == aiManager.launcher",
          "group": "navigation"
        },
        {
          "command": "aiManager.refresh",
          "when": "view == aiManager.launcher",
          "group": "navigation"
        },
        {
          "command": "aiManager.sync",
          "when": "view == aiManager.launcher",
          "group": "navigation"
        }
      ],
      "view/item/context": [
        {
          "command": "aiManager.installItem",
          "when": "view == aiManager.launcher && viewItem == availableItem",
          "group": "inline"
        },
        {
          "command": "aiManager.removeItem",
          "when": "view == aiManager.launcher && viewItem == installedItem",
          "group": "inline"
        }
      ]
    }
  },
  "scripts": {
    "build": "node scripts/sync-tooling.mjs && node esbuild.js",
    "vscode:prepublish": "npm run build && npm run build:core",
    "compile": "tsc -p . --noEmit",
    "watch": "node esbuild.js --watch",
    "dev": "node esbuild.js && node tools/dev-server.mjs",
    "test": "tsc -p tsconfig.test.json && node --test tests/logic.test.js tests/core-params.test.js tests/core-client.test.js",
    "package": "npm run build && npx --yes --ignore-scripts @vscode/vsce package --no-dependencies --out releases/",
    "sync-tooling": "node scripts/sync-tooling.mjs",
    "build:core": "dotnet publish src/AiWorkspaceManager.Core/AiWorkspaceManager.Core.csproj -c Release -o dist/core",
    "test:core": "dotnet test AIWorkspaceManager.slnx -c Release",
    "quality": "npm run compile && npm test && npm run build:core && npm run test:core"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@types/vscode": "^1.90.0",
    "esbuild": "^0.24.0",
    "typescript": "^5.6.0"
  },
  "dependencies": {
    "lit": "^3.2.1"
  }
}
