<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Shared test fixtures and temp-directory helpers. Not a test project: it holds no [TestClass].
    `Fixtures/**` is data, never compiled.
  -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>AiWorkspaceManager.TestUtilities</RootNamespace>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <Compile Remove="Fixtures\**" />
    <None Include="Fixtures\**" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\AiWorkspaceManager.Common\AiWorkspaceManager.Common.csproj" />
  </ItemGroup>

</Project>
